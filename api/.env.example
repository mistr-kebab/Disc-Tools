# =============================================
#  Disc-Tools API — Environment Template
#  Copy to .env and fill in your credentials:
#      cp .env.example .env
# =============================================

# --- Server ---
PORT=3000
HOST=127.0.0.1

# --- Auth & Security ---
JWT_SECRET=your-jwt-secret
IP_HASH_SALT=your-ip-hash-salt

# --- Discord ---
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=https://disc-tools.de/auth/callback
DISCORD_BOT_TOKEN=your-bot-token
GUILD_ID=your-guild-id

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=disctools
DB_USER=your-db-user
DB_PASSWORD=your-db-password


# --- Optional integrations ---
# DISCORD_INVITE=https://discord.gg/your-invite
# SPOTIFY_CLIENT_ID=your-spotify-client-id
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# SPOTIFY_REDIRECT_URI=https://disc-tools.de/api/auth/spotify/callback
# TWITCH_CLIENT_ID=your-twitch-client-id
# TWITCH_CLIENT_SECRET=your-twitch-client-secret
# TWITCH_REDIRECT_URI=https://disc-tools.de/api/auth/twitch/callback
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_REDIRECT_URI=https://disc-tools.de/api/auth/github/callback
# GIFS_INTERNAL_SECRET=your-internal-secret
